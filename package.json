{
  "name": "@wave-rf/starlight-llm-tools",
  "version": "0.3.1",
  "description": "Starlight plugin that adds LLM-friendly tooling to your docs site: per-page `.md` twins with navigation headers, llms.txt / llms-full.txt / llms-small.txt routes, and Copy-Markdown + Open-with-AI buttons in the page header. Optional transform pipeline plays nicely with starlight-glossary.",
  "keywords": [
    "astro",
    "astro-integration",
    "starlight",
    "starlight-plugin",
    "llms-txt",
    "llm",
    "markdown",
    "documentation",
    "ai"
  ],
  "license": "MIT",
  "author": {
    "name": "Wave RF",
    "email": "github@wave-rf.com",
    "url": "https://wave-rf.com"
  },
  "contributors": [
    "Eric Andrechek <eric@wave-rf.com>"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/Wave-RF/starlight-llm-tools.git"
  },
  "bugs": {
    "url": "https://github.com/Wave-RF/starlight-llm-tools/issues"
  },
  "homepage": "https://github.com/Wave-RF/starlight-llm-tools#readme",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./lib": "./src/lib/index.ts",
    "./components/*": "./src/components/*"
  },
  "files": [
    "src",
    "README.md",
    "LICENSE"
  ],
  "publishConfig": {
    "access": "public"
  },
  "packageManager": "pnpm@11.1.3",
  "engines": {
    "node": ">=18.0.0"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "biome lint .",
    "format": "biome format --write .",
    "check": "biome check .",
    "verify": "biome check . && pnpm run typecheck && bash scripts/ci-marker.sh write",
    "setup": "git config core.hooksPath .githooks"
  },
  "peerDependencies": {
    "@astrojs/starlight": ">=0.36.0",
    "astro": ">=5.0.0",
    "starlight-glossary": ">=1.0.0"
  },
  "peerDependenciesMeta": {
    "starlight-glossary": {
      "optional": true
    }
  },
  "devDependencies": {
    "@astrojs/starlight": "^0.41.3",
    "@biomejs/biome": "^2.4.15",
    "@types/node": "^26.1.1",
    "astro": "^7.0.7",
    "typescript": "^7.0.2"
  }
}
